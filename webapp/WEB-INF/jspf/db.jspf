<%@ page import="java.sql.*, java.util.*, java.io.*" %>
<%!
    // Reads the database settings stored outside the public web pages.
    private Properties loadDbProps(ServletContext ctx) throws IOException {
        Properties p = new Properties();
        try (InputStream in = ctx.getResourceAsStream("/META-INF/db.properties")) {
            if (in == null) throw new IOException("Could not find META-INF/db.properties");
            p.load(in);
        }
        return p;
    }

    private Connection openConnection(ServletContext ctx) throws Exception {
        Properties p = loadDbProps(ctx);
        Class.forName("com.mysql.cj.jdbc.Driver");
        return DriverManager.getConnection(
            p.getProperty("db.url"), p.getProperty("db.user"), p.getProperty("db.password"));
    }

    // Table names come straight from MySQL, so the page only ever queries tables that exist
    private List<String> listTables(Connection c) throws SQLException {
        List<String> names = new ArrayList<>();
        try (Statement s = c.createStatement(); ResultSet rs = s.executeQuery("SHOW TABLES")) {
            while (rs.next()) names.add(rs.getString(1));
        }
        return names;
    }

    private String quote(String table) {
        return "`" + table.replace("`", "``") + "`";
    }

    private long countRows(Connection c, String table) throws SQLException {
        try (Statement s = c.createStatement();
             ResultSet rs = s.executeQuery("SELECT COUNT(*) FROM " + quote(table))) {
            return rs.next() ? rs.getLong(1) : 0;
        }
    }

    // "booking_pet" -> "Booking pet"
    private String friendly(String table) {
        String s = table.replace('_', ' ').toLowerCase();
        return s.isEmpty() ? s : Character.toUpperCase(s.charAt(0)) + s.substring(1);
    }

    private String esc(Object o) {
        if (o == null) return "";
        String s = String.valueOf(o);
        StringBuilder b = new StringBuilder(s.length());
        for (char ch : s.toCharArray()) {
            switch (ch) {
                case '<': b.append("&lt;"); break;
                case '>': b.append("&gt;"); break;
                case '&': b.append("&amp;"); break;
                case '"': b.append("&quot;"); break;
                case '\'': b.append("&#39;"); break;
                default: b.append(ch);
            }
        }
        return b.toString();
    }

    private String url(String s) {
        try { return java.net.URLEncoder.encode(s, "UTF-8"); }
        catch (Exception e) { return s; }
    }

    // Colors status values (booking and payment) the same way everywhere
    private String chipClass(String value) {
        if (value == null) return null;
        String v = value.trim().toLowerCase();
        if (v.equals("requested") || v.equals("pending")) return "chip-requested";
        if (v.equals("confirmed") || v.equals("paid")) return "chip-confirmed";
        if (v.equals("in progress") || v.equals("in_progress")) return "chip-progress";
        if (v.equals("completed")) return "chip-completed";
        if (v.equals("cancelled") || v.equals("canceled") || v.equals("refunded") || v.equals("declined")) return "chip-cancelled";
        return null;
    }

    // Turns common connection errors into a plain next step
    private String hintFor(Exception e) {
        String m = String.valueOf(e.getMessage());
        if (e instanceof ClassNotFoundException)
            return "The MySQL driver is missing. Copy mysql-connector-j-*.jar into WEB-INF/lib, then restart Tomcat.";
        if (m.contains("Access denied"))
            return "MySQL rejected the username or password. Check db.user and db.password in META-INF/db.properties.";
        if (m.contains("Unknown database"))
            return "The database name in db.url does not exist. Use the schema name shown in MySQL Workbench.";
        if (m.contains("Communications link failure"))
            return "Tomcat could not reach MySQL. Start the MySQL server and check the port in db.url (usually 3306).";
        if (m.contains("db.properties"))
            return "Create META-INF/db.properties with your connection details.";
        return "Check the connection details in META-INF/db.properties.";
    }

    private String hashPassword(String password) throws Exception {
        byte[] salt = new byte[16];
        new java.security.SecureRandom().nextBytes(salt);
        byte[] hash = derivePassword(password, salt);
        return java.util.Base64.getEncoder().encodeToString(salt) + ":" +
               java.util.Base64.getEncoder().encodeToString(hash);
    }

    private byte[] derivePassword(String password, byte[] salt) throws Exception {
        javax.crypto.spec.PBEKeySpec spec = new javax.crypto.spec.PBEKeySpec(
            password.toCharArray(), salt, 120000, 256);
        try {
            return javax.crypto.SecretKeyFactory.getInstance("PBKDF2WithHmacSHA256")
                .generateSecret(spec).getEncoded();
        } finally { spec.clearPassword(); }
    }

    private boolean verifyPassword(String password, String stored) throws Exception {
        if (stored == null || password == null) return false;
        // The sample rows in petcare_manager.sql use SHA2('pw_name',256), which MySQL stores as 64 hex characters.
        // New accounts made on the sign-up page use the stronger salted format "salt:hash" below.
        if (stored.matches("[0-9a-fA-F]{64}")) {
            byte[] d = java.security.MessageDigest.getInstance("SHA-256")
                .digest(password.getBytes(java.nio.charset.StandardCharsets.UTF_8));
            StringBuilder hex = new StringBuilder();
            for (byte x : d) hex.append(String.format("%02x", x));
            return java.security.MessageDigest.isEqual(
                hex.toString().getBytes(), stored.toLowerCase().getBytes());
        }
        String[] parts = stored.split(":", 2);
        if (parts.length != 2) return false;
        byte[] salt = java.util.Base64.getDecoder().decode(parts[0]);
        byte[] expected = java.util.Base64.getDecoder().decode(parts[1]);
        byte[] actual = derivePassword(password, salt);
        return java.security.MessageDigest.isEqual(expected, actual);
    }

    private int intParam(String value, int fallback) {
        try { return Integer.parseInt(value); } catch (Exception e) { return fallback; }
    }

    private double doubleParam(String value, double fallback) {
        try { return Double.parseDouble(value); } catch (Exception e) { return fallback; }
    }

    private boolean isLoggedIn(jakarta.servlet.http.HttpSession session) {
        return session != null && session.getAttribute("userId") != null;
    }

    private boolean isSitter(jakarta.servlet.http.HttpSession session) {
        return isLoggedIn(session) && "sitter".equals(session.getAttribute("role"));
    }

    // ---- Helpers that match the petcare_manager schema ----

    // Allowed values of the ENUM columns, copied from petcare_manager.sql
    private static final String[] SERVICE_CATEGORIES = {"WALKING", "BOARDING", "DAYCARE", "HOUSE_SITTING"};
    private static final String[] BOOKING_STATUSES = {"REQUESTED", "CONFIRMED", "IN_PROGRESS", "COMPLETED", "CANCELLED", "DECLINED"};
    private static final String[] ACTIVE_STATUSES = {"REQUESTED", "CONFIRMED", "IN_PROGRESS"};
    private static final String[] PAYMENT_METHODS = {"CASH", "CREDIT_CARD", "VENMO", "ZELLE"};
    private static final String[] PAYMENT_STATUSES = {"PENDING", "PAID", "REFUNDED"};
    private static final String[] PET_GENDERS = {"Male", "Female", "Unknown"};

    // "CREDIT_CARD" -> "Credit card", "IN_PROGRESS" -> "In progress"
    private String label(String value) {
        if (value == null) return "";
        String s = value.replace('_', ' ').toLowerCase();
        return s.isEmpty() ? s : Character.toUpperCase(s.charAt(0)) + s.substring(1);
    }

    // Returns value only if it is one of the allowed values, otherwise null
    private String pick(String value, String[] allowed) {
        if (value == null) return null;
        for (String a : allowed) if (a.equalsIgnoreCase(value.trim())) return a;
        return null;
    }

    // Builds <option> tags for a dropdown, with the current value selected
    private String options(String[] values, String selected) {
        StringBuilder b = new StringBuilder();
        for (String v : values) {
            b.append("<option value=\"").append(esc(v)).append('"');
            if (v.equalsIgnoreCase(selected == null ? "" : selected)) b.append(" selected");
            b.append('>').append(esc(label(v))).append("</option>");
        }
        return b.toString();
    }

    // Trimmed text, or null when the box was left empty
    private String text(String value) {
        if (value == null) return null;
        String t = value.trim();
        return t.isEmpty() ? null : t;
    }

    // Reads a datetime-local box ("2026-10-25T08:00") as a date and time with no time zone attached
    private java.time.LocalDateTime parseLocal(String value) {
        String v = text(value);
        if (v == null) return null;
        try { return java.time.LocalDateTime.parse(v.length() == 16 ? v + ":00" : v); }
        catch (Exception e) { return null; }
    }

    // "2026-08-01 09:00:00" -> "Aug 1, 2026, 9:00 AM". Read DATETIME columns with rs.getString so no time zone shift happens.
    private String dt(String value) {
        if (value == null) return "";
        try {
            java.time.LocalDateTime t = java.time.LocalDateTime.parse(value.trim().replace(' ', 'T').replaceAll("\\.\\d+$", ""));
            return t.format(java.time.format.DateTimeFormatter.ofPattern("MMM d, yyyy, h:mm a", java.util.Locale.US));
        } catch (Exception e) { return value; }
    }

    // Writes a row to AuditLog. If it fails, the page keeps working.
    private void audit(Connection c, int userId, String action, String description) {
        try (PreparedStatement ps = c.prepareStatement("INSERT INTO AuditLog(UserID,Action,Description) VALUES(?,?,?)")) {
            ps.setInt(1, userId); ps.setString(2, action); ps.setString(3, description); ps.executeUpdate();
        } catch (Exception ignored) { }
    }
%>
